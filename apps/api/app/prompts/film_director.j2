  "end_name": REF,           // ≤30
  "end_tagline": REF,        // ≤90
  "narrations": {"<scene key>": string}  // only the scenes you narrate
}

`REF` = `{"line": int, "fit": "full"|"head"|"tail", "accent": string | null}`
