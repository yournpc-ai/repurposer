# Text/code LLM provider (media generation remains provider-specific)
LLM_PROVIDER=minimax

# Minimax
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Optional local JSONL: complete provider request/response payloads for all
# text/code providers. Empty disables body capture. Local file; do not commit.
LLM_TRACE_PATH=

# Internal install layout: <root>/promo-video/<version>/SKILL.md, with the
# unmodified video-shotcraft checkout in that version directory.
# MANAGED_SKILL_ROOT=/absolute/path/to/installed-skills
# MANAGED_SKILL_VERSIONS={"promo-video":"<pinned-release>"}

# DeepSeek (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high
# DeepSeek defaults non-thinking output to 8K; large design tool calls need more.
DEEPSEEK_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_CNY_PER_USD=7.2
# Optional comma-separated YYYY-MM-DD public holidays treated as off-peak
DEEPSEEK_OFFPEAK_DATES=

# Auth / Email
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=Rookie <repurposer@yournpc.ai>
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repurposer

# Storage (S3-compatible object storage, e.g. Volcengine TOS)
# All user uploads and rendered outputs are stored as object keys.
# Reads are public; uploads use presigned PUT URLs generated by the backend.
S3_ENDPOINT_URL=https://tos-s3-ap-southeast-1.volces.com
S3_BUCKET_NAME=repurposer
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=ap-southeast-1
S3_PUBLIC_URL=https://repurposer.tos-ap-southeast-1.volces.com
S3_PRESIGN_UPLOAD_TTL=3600

# Backend
API_HOST=0.0.0.0
API_PORT=8000
# Freesound CC0 SFX search/import (empty = unavailable)
FREESOUND_API_KEY=

# component-v1 bake is fail-closed without real runner isolation. Keep false
# until API and render deployments enforce unprivileged execution, temporary
# filesystems, egress denial, resource/concurrency caps and process-tree cleanup.
COMPONENT_BAKE_ENABLED=false

# Payments — hosted Stripe Checkout. Presets and custom amounts both use
# server-defined price_data; no Stripe Product/Price configuration is needed.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
# Comma-separated operations email recipients; consumed by the worker only.
# Resend remains the delivery provider, so RESEND_API_KEY/FROM_EMAIL are required.
PAYMENT_ALERT_RECIPIENTS=ops@example.com

# Distribution — channel OAuth (presence-gating: empty = channel hidden in UI)
# Redirect URI 派生自 API_PUBLIC_URL：{API_PUBLIC_URL}/api/v1/channels/{platform}/callback
# 平台后台必须登记完全一致的 URI（dev/prod 各一套）
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Fernet key for channel token encryption (ADR-031): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_CREDENTIALS_KEY=

# Frontend
VITE_API_URL=http://localhost:8000

