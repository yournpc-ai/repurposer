              "project": {
                "schema_version": 1,
                "entry": "Boundary.tsx",
                "composition_id": "SignalTitle",
                "files": [
                  {
                    "path": "Boundary.tsx",
                    "content": "import React from 'react';\n\nexport interface BoundaryProps {\n  frame: number;\n  headline: string;\n  ink: string;\n  rate: number;\n}\nexport function Aperture({frame, rate, children}: Pick<BoundaryProps,'frame'|'rate'> & {children:React.ReactNode}) {\n  const phase = frame * rate / 17;\n  const cx = 49 + 22 * Math.sin(phase);\n  const radius = 39 + 12 * Math.cos(phase * .8);\n  return <div style={{position:'absolute',left:80,top:20,width:480,height:270,\n    maskImage:`radial-gradient(ellipse at ${cx}% 49%, black ${radius}%, transparent ${radius + 17}%)`,\n    clipPath:'polygon(0 0, 100% 0, 100% 73%, 84% 100%, 0 100%)'}}>{children}</div>;\n}\nexport function Caption({frame,headline,ink}:BoundaryProps) {\n  const progress=Math.max(0,Math.min(1,frame/18));\n  return <svg width=\"580\" height=\"310\" style={{position:'absolute',inset:0}}>\n    <defs><clipPath id=\"reveal\"><rect x=\"8\" y=\"170\" width={425*progress} height=\"100\"/></clipPath></defs>\n    <g clipPath=\"url(#reveal)\">\n      <rect x=\"8\" y=\"191\" width=\"343\" height=\"65\" rx=\"8\" fill=\"#09232d\" fillOpacity=\".76\"/>\n      <text x=\"23\" y=\"235\" fontFamily=\"Arial\" fontWeight=\"700\" fontSize=\"35\" fill={ink}>{headline}</text>\n    </g>\n    <path d=\"M 55 171 L 86 142 L 137 142\" fill=\"none\" stroke={ink} opacity={progress} strokeWidth=\"3\"/>\n  </svg>;\n}\n",
                    "digest": "30c20aea3c748ca50d4b58ebbee1f485d40705bcfe20ff915623e29d3c440c38"
                  },
                  {
                    "path": "scene.tsx",
                    "content": "import React from 'react';\nimport {OffthreadVideo, Sequence, useCurrentFrame} from 'remotion';\nimport {Video} from './Video';\nimport {Aperture,Caption} from './Boundary';\n\nfunction Inset({data}:any) {\n  const k=useCurrentFrame();\n  const {pip,mg}=data;\n  const local=k+pip.start_frame-mg.start;\n  const {x,y,width,height}=pip.object.layout;\n  const video=<OffthreadVideo src={pip.source.url} startFrom={pip.source.start_frame} muted style={{width,height,display:'block'}}/>;\n  if(local<0 || local>=mg.end-mg.start)return <div style={{position:'absolute',left:x,top:y}}>{video}</div>;\n  const props={...mg.props,frame:local};\n  return <div style={{position:'absolute',left:mg.layout.x,top:mg.layout.y}}>\n    <Aperture {...props}>{video}</Aperture><Caption {...props}/>\n  </div>;\n}\nexport function Scene({data}:any){\n  const p=data.pip;\n  return <><Video spec={data.spec}/><Sequence from={p.start_frame} durationInFrames={p.end_frame-p.start_frame}><Inset data={data}/></Sequence></>;\n}\n",
                    "digest": "57c295e0e3745b76c43e2aa205192c3d6c739441de47a4598ee2a8b57d0d8ec6"
                  }
                ],
