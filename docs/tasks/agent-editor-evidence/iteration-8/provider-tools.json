{
  "insert_visual": {
    "name": "insert_visual",
    "description": "Place a fixed project image above the existing footage for a timeline window. Use the returned object ID for later position or scale changes.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "description": "Fixed image snapshot returned by prepare_video_materials.",
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "start_seconds": {
          "description": "Inclusive composition time.",
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "description": "Exclusive composition time.",
          "exclusiveMinimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "position": {
          "default": "top_right",
          "enum": [
            "top_left",
            "top_right",
            "bottom_left",
            "bottom_right"
          ],
          "title": "Position",
          "type": "string"
        },
        "width_ratio": {
          "default": 0.25,
          "description": "Fraction of canvas width; preserves image proportions.",
          "exclusiveMinimum": 0.05,
          "maximum": 1,
          "title": "Width Ratio",
          "type": "number"
        }
      },
      "required": [
        "source_id",
        "start_seconds",
        "end_seconds"
      ],
      "title": "InsertVisualArgs",
      "type": "object"
    }
  },
